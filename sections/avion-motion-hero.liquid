{% comment %}
  Avion Motion Hero
  ─────────────────
  Pure CSS / vanilla-JS motion-graphics hero.
  No WebGL, no Three.js, no build step.

  Sequence:
    1. Desert background fades + subtle Ken-Burns zoom
    2. Plane dives in from upper-left nose-down, curls level into rest position
    3. Settles just above the logo and idles with a gentle bob
    4. Logo reveals beneath with a spring pop
    5. Scroll hint pulses in

  Setup: upload the three images to Shopify Admin → Content → Files,
  then assign them in the section settings (image picker or URL field).
{% endcomment %}

{%- comment %} ── Resolve asset URLs ───────────────────────────────────── {%- endcomment %}
{%- assign amh_bg    = '' -%}
{%- assign amh_plane = '' -%}
{%- assign amh_logo  = '' -%}

{%- if section.settings.bg_image != blank -%}
  {%- assign amh_bg = section.settings.bg_image | image_url: width: 1920 -%}
{%- elsif section.settings.bg_url != blank -%}
  {%- assign amh_bg = section.settings.bg_url -%}
{%- endif -%}

{%- if section.settings.plane_image != blank -%}
  {%- assign amh_plane = section.settings.plane_image | image_url: width: 600 -%}
{%- elsif section.settings.plane_url != blank -%}
  {%- assign amh_plane = section.settings.plane_url -%}
{%- endif -%}

{%- if section.settings.logo_image != blank -%}
  {%- assign amh_logo = section.settings.logo_image | image_url: width: 760 -%}
{%- elsif section.settings.logo_url != blank -%}
  {%- assign amh_logo = section.settings.logo_url -%}
{%- endif -%}

{%- assign bridge_col = section.settings.bridge_color | default: '#1a1a1a' -%}

{% style %}

/* ── Box-sizing reset scoped to this section ──────────────── */
.amh, .amh *, .amh *::before, .amh *::after { box-sizing: border-box; }

/* ── Section container ────────────────────────────────────── */
.amh {
  position: relative;
  z-index: 0; /* creates stacking context — keeps plane/logo below the navbar */
  width: 100%;
  height: 100svh;
  min-height: 560px;
  overflow: hidden;
  background: #3d6b4a;
}

/* ── Background image ─────────────────────────────────────── */
.amh__bg {
  position: absolute;
  /* Bleed 6% on each side so the Ken-Burns / parallax never shows edges */
  inset: -3%;
  width: 106%;
  height: 106%;
  background-image: var(--amh-bg-url, none);
  background-size: cover;
  background-position: center 45%;
  background-repeat: no-repeat;
  transform-origin: center center;
  animation: amh-ken-burns 1.2s cubic-bezier(0.4, 0, 0.2, 1) both;
  will-change: transform;
}

@keyframes amh-ken-burns {
  from { transform: scale(1.04); opacity: 0.6; }
  to   { transform: scale(1.00); opacity: 1; }
}

/* ── Cinematic vignette ───────────────────────────────────── */
.amh__vignette {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background:
    radial-gradient(ellipse 90% 75% at 50% 38%, transparent 28%, rgba(4,10,3,0.60) 100%),
    linear-gradient(180deg,
      rgba(4,10,3,0.14)  0%,
      transparent        38%,
      rgba(12,6,2,0.24)  75%,
      rgba(12,6,2,0.58) 100%
    );
}

/* ── Logo contrast backdrop ───────────────────────────────── */
.amh__logo-backdrop {
  position: absolute;
  left: 50%;
  top: 60%;
  transform: translate(-50%, -50%);
  width: 54%;
  height: 40%;
  background: radial-gradient(ellipse at center, rgba(6,3,1,0.48) 0%, transparent 70%);
  z-index: 3;
  pointer-events: none;
}

/* ── Plane ────────────────────────────────────────────────── */
.amh__plane {
  position: absolute;
  left: 50%;
  top: 38%;
  width: clamp(160px, 22vw, 280px);
  height: auto;
  /*
    translateZ(0) promotes this element to its own GPU compositor layer
    so the browser moves a cached texture — zero repaints per frame.
    IMPORTANT: no filter here — drop-shadow on a composited animated
    element forces per-frame GPU rasterisation and is the primary cause
    of animation jank, especially on mobile.
  */
  transform: translate(-50%, -50%) translateZ(0);
  transform-origin: center center;
  opacity: 0;
  z-index: 10;
  pointer-events: none;
  will-change: transform;
  transition: opacity 0.45s ease-out;
}

.amh__plane--flying,
.amh__plane--visible { opacity: 1; }

.amh__plane-img {
  width: 100%;
  height: auto;
  display: block;
  user-select: none;
  -webkit-user-drag: none;
  pointer-events: none;
}

/* Shadow only during idle so it does not tax the flight animation.
   Applied to the img child so it doesn't affect the compositor layer. */
.amh__plane--idle .amh__plane-img {
  filter:
    drop-shadow(0 5px 14px rgba(0,0,0,0.36))
    drop-shadow(0 2px  4px rgba(0,0,0,0.20));
}

/* Main flight is driven by requestAnimationFrame so the plane follows a
   continuous curve instead of interpolating between hand-placed keyframes. */

/* ── Phase 3 — Idle bob (infinite) ────────────────────────── */
.amh__plane--idle {
  animation: amh-idle 5s ease-in-out infinite;
}

@keyframes amh-idle {
  0%   { transform: translate(-50%, -50%) rotate( 0.0deg); }
  25%  { transform: translate(calc(-50% + 5px), calc(-50% -  8px)) rotate( 1.8deg); }
  50%  { transform: translate(calc(-50% + 2px), calc(-50% +  6px)) rotate(-1.0deg); }
  75%  { transform: translate(calc(-50% - 5px), calc(-50% -  3px)) rotate( 2.2deg); }
  100% { transform: translate(-50%, -50%) rotate( 0.0deg); }
}

/* ── Logo ─────────────────────────────────────────────────── */
.amh__logo-wrap {
  position: absolute;
  left: 50%;
  top: 60%;
  transform: translate(-50%, calc(-50% + 22px)) scale(0.84);
  z-index: 9;
  pointer-events: none;
  opacity: 0;
  will-change: transform, opacity;
}

.amh__logo-img {
  width: clamp(200px, 28vw, 370px);
  height: auto;
  display: block;
  user-select: none;
  -webkit-user-drag: none;
  pointer-events: none;
  filter:
    drop-shadow(0 8px 32px rgba(0,0,0,0.70))
    drop-shadow(0 0  14px rgba(0,0,0,0.45));
}

/* Spring pop reveal */
.amh__logo-wrap--revealed {
  animation: amh-logo-reveal 1.4s cubic-bezier(0.34, 1.40, 0.64, 1) forwards;
}

@keyframes amh-logo-reveal {
  0%   { opacity: 0; transform: translate(-50%, calc(-50% + 24px)) scale(0.82); }
  50%  { opacity: 1; }
  100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

/* ── Scroll hint ─────────────────────────────────────────── */
.amh__scroll-hint {
  position: absolute;
  bottom: 2.8rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  opacity: 0;
  transition: opacity 1s ease;
  pointer-events: none;
}

.amh__scroll-hint--visible { opacity: 1; }

.amh__scroll-chevron {
  width: 20px;
  height: 20px;
  border-right: 2px solid rgba(255,243,220,0.78);
  border-bottom: 2px solid rgba(255,243,220,0.78);
  transform: rotate(45deg);
  animation: amh-chevron 2.3s ease-in-out infinite;
}

.amh__scroll-chevron + .amh__scroll-chevron {
  margin-top: -13px;
  animation-delay: 0.24s;
  opacity: 0.42;
}

.amh__scroll-label {
  font-family: system-ui, -apple-system, sans-serif;
  font-size: 0.56rem;
  letter-spacing: 0.30em;
  text-transform: uppercase;
  color: rgba(255,243,220,0.55);
  margin-top: 0.65rem;
}

@keyframes amh-chevron {
  0%, 100% { opacity: 0.22; transform: rotate(45deg) translateY(0); }
  50%       { opacity: 1;    transform: rotate(45deg) translateY(5px); }
}

/* ── Bridge gradient ─────────────────────────────────────── */
.amh__bridge {
  position: relative;
  z-index: 1;
  height: 20vh;
  background: linear-gradient(to bottom, rgba(10,5,2,0.92), {{ bridge_col }});
  pointer-events: none;
  margin-top: -1px;
}

/* ── Stacking fix: sections below must sit above this one ─── */
.avion-motion-page .shopify-section {
  position: relative;
  z-index: 1;
}
.avion-motion-page #shopify-section-{{ section.id }} {
  position: static;
  z-index: auto;
}

/* ── Tablet ──────────────────────────────────────────────── */
@media (max-width: 900px) {
  .amh__plane         { width: clamp(140px, 28vw, 220px); top: 36%; }
  .amh__logo-wrap     { top: 60%; }
  .amh__logo-backdrop { top: 60%; width: 72%; }
}

/* ── Mobile ─────────────────────────────────────────────────
   Sticky header ~60-70px (z-index 10020).
   Plane rest  = 33% → 33% of 750px ≈ 248px from top.
   Loop peak   = 33% − 12vh ≈ 248 − 90 = 158px — well below nav.
   Fly-in start is off-screen above the viewport so the plane
   "arrives" cleanly without crossing behind the navbar.        */
@media (max-width: 600px) {
  .amh__plane         { width: clamp(155px, 56vw, 240px); top: 33%; }
  .amh__logo-wrap     { top: 53%; width: clamp(240px, 80vw, 300px); }
  .amh__logo-img      { width: 100%; max-width: none; }
  .amh__logo-backdrop { top: 53%; width: 96%; height: 38%; }
}

/* ── Reduced motion ──────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .amh__bg { animation: none; transform: scale(1.00); }
  .amh__plane { opacity: 1; transform: translate(-50%, -50%) translateZ(0); }
  .amh__plane--flying,
  .amh__plane--idle { animation: none !important; }
  .amh__plane--idle .amh__plane-img { filter: none; }
  .amh__logo-wrap { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  .amh__logo-wrap--revealed { animation: none !important; opacity: 1; transform: translate(-50%, -50%) scale(1); }
  .amh__scroll-hint { opacity: 1; }
}

{% endstyle %}

{%- comment %} Mark page so stacking CSS above only fires here ─── {%- endcomment %}
<script>document.documentElement.classList.add('avion-motion-page');</script>

{%- comment %} Preload the background for LCP ───────────────────── {%- endcomment %}
{%- if amh_bg != '' -%}
  <link rel="preload" as="image" href="{{ amh_bg }}" fetchpriority="high">
{%- endif -%}

<section
  class="amh"
  id="amh-hero"
  aria-label="{{ shop.name }} hero"
>

  {%- comment %} Background ─────────────────────────────────────── {%- endcomment %}
  <div
    class="amh__bg"
    {%- if amh_bg != '' %} style="--amh-bg-url: url('{{ amh_bg }}')"{% endif %}
  ></div>

  {%- comment %} Vignette ───────────────────────────────────────── {%- endcomment %}
  <div class="amh__vignette" aria-hidden="true"></div>

  {%- comment %} Logo contrast backdrop ──────────────────────────── {%- endcomment %}
  <div class="amh__logo-backdrop" aria-hidden="true"></div>

  {%- comment %} Plane (animated) ────────────────────────────────── {%- endcomment %}
  {%- if amh_plane != '' -%}
  <div class="amh__plane" id="amh-plane" aria-hidden="true">
    <img
      class="amh__plane-img"
      src="{{ amh_plane }}"
      alt=""
      role="presentation"
      loading="eager"
      width="600"
      height="300"
      draggable="false"
    >
  </div>
  {%- endif -%}

  {%- comment %} Logo ────────────────────────────────────────────── {%- endcomment %}
  {%- if amh_logo != '' -%}
  <div class="amh__logo-wrap" id="amh-logo">
    <img
      class="amh__logo-img"
      src="{{ amh_logo }}"
      alt="{{ shop.name }}"
      loading="eager"
      draggable="false"
    >
  </div>
  {%- endif -%}

  {%- comment %} Scroll hint ─────────────────────────────────────── {%- endcomment %}
  {%- if section.settings.show_scroll_hint -%}
  <div class="amh__scroll-hint" id="amh-scroll">
    <div class="amh__scroll-chevron" aria-hidden="true"></div>
    <div class="amh__scroll-chevron" aria-hidden="true"></div>
    <span class="amh__scroll-label" aria-hidden="true">Scroll</span>
  </div>
  {%- endif -%}

</section>


<script>
(function () {
  'use strict';

  var plane  = document.getElementById('amh-plane');
  var logo   = document.getElementById('amh-logo');
  var scroll = document.getElementById('amh-scroll');
  var hero   = document.getElementById('amh-hero');
  var bg     = hero && hero.querySelector('.amh__bg');

  /* ── Reduced-motion: jump straight to final state ─────── */
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (logo)   { logo.style.cssText  = 'opacity:1;transform:translate(-50%,-50%) scale(1)'; }
    if (scroll) { scroll.classList.add('amh__scroll-hint--visible'); }
    return;
  }

  /* ── Scroll parallax on background ───────────────────── */
  if (bg && hero) {
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (!ticking) {
        window.requestAnimationFrame(function () {
          var sy = window.scrollY;
          var h  = hero.offsetHeight;
          if (sy < h) {
            /* Gentle upward drift as user scrolls — max 6% of the 12% bleed */
            bg.style.transform = 'scale(1.00) translateY(' + ((sy / h) * 3).toFixed(2) + '%)';
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  /* ── Animation sequence ───────────────────────────────── */
  if (!plane) return;

  function cubicPoint(p0, p1, p2, p3, t) {
    var inv = 1 - t;
    var inv2 = inv * inv;
    var t2 = t * t;

    return {
      x: inv2 * inv * p0.x + 3 * inv2 * t * p1.x + 3 * inv * t2 * p2.x + t2 * t * p3.x,
      y: inv2 * inv * p0.y + 3 * inv2 * t * p1.y + 3 * inv * t2 * p2.y + t2 * t * p3.y
    };
  }

  function cubicTangent(p0, p1, p2, p3, t) {
    var inv = 1 - t;

    return {
      x: 3 * inv * inv * (p1.x - p0.x) + 6 * inv * t * (p2.x - p1.x) + 3 * t * t * (p3.x - p2.x),
      y: 3 * inv * inv * (p1.y - p0.y) + 6 * inv * t * (p2.y - p1.y) + 3 * t * t * (p3.y - p2.y)
    };
  }

  function flightMetrics() {
    var width  = hero.offsetWidth  || window.innerWidth;
    var height = hero.offsetHeight || window.innerHeight;
    var mobile = window.matchMedia('(max-width: 600px)').matches;

    /* Dives in from upper-left, nose-down, curls level into rest */
    return {
      duration: mobile ? 2400 : 2800,
      p0: { x: width  * (mobile ? -0.42 : -0.50), y: height * (mobile ? -0.22 : -0.30) },
      p1: { x: width  * (mobile ? -0.32 : -0.38), y: height * (mobile ? -0.12 : -0.18) },
      p2: { x: width  * (mobile ? -0.095 : -0.13), y: 0 },
      p3: { x: 0, y: 0 }
    };
  }

  function offsetCalc(value) {
    var amount = Math.abs(value).toFixed(2);

    if (value < 0) return 'calc(-50% - ' + amount + 'px)';
    return 'calc(-50% + ' + amount + 'px)';
  }

  function renderPlane(point, angle) {
    plane.style.transform =
      'translate3d(' + offsetCalc(point.x) + ', ' + offsetCalc(point.y) + ', 0) ' +
      'rotate(' + angle.toFixed(2) + 'deg)';
  }

  function renderFlight(metrics, progress) {
    /* Cubic ease-out: blazes in fast, glides smoothly into rest */
    var eased   = 1 - Math.pow(1 - progress, 3);
    var point   = cubicPoint(metrics.p0, metrics.p1, metrics.p2, metrics.p3, eased);
    var tangent = cubicTangent(metrics.p0, metrics.p1, metrics.p2, metrics.p3, eased);
    var angle   = Math.atan2(tangent.y, tangent.x) * 180 / Math.PI;
    renderPlane(point, angle);
  }

  function runSequence() {
    var metrics      = flightMetrics();
    var start        = null;
    var logoRevealed = false;

    function finishFlight() {
      plane.classList.remove('amh__plane--flying');
      plane.classList.add('amh__plane--visible', 'amh__plane--idle');
      plane.style.transform = '';
      setTimeout(function () {
        if (scroll) scroll.classList.add('amh__scroll-hint--visible');
      }, 900);
    }

    function frame(timestamp) {
      if (start === null) start = timestamp;

      var progress = Math.min((timestamp - start) / metrics.duration, 1);
      renderFlight(metrics, progress);

      /* Cubic ease-out reaches ~97% position at raw progress 0.68 —
         start the logo reveal then so it fades in as the plane glides home */
      if (!logoRevealed && progress >= 0.68) {
        logoRevealed = true;
        if (logo) logo.classList.add('amh__logo-wrap--revealed');
      }

      if (progress < 1) {
        window.requestAnimationFrame(frame);
      } else {
        finishFlight();
      }
    }

    renderFlight(metrics, 0);
    window.requestAnimationFrame(function () {
      plane.classList.add('amh__plane--flying');
      window.requestAnimationFrame(frame);
    });
  }

  /* ── Wait for the plane image to decode before starting ── */
  var img    = plane.querySelector('img');
  var ready  = false;

  function startWhenReady() {
    if (ready) return;
    ready = true;
    setTimeout(runSequence, 250);
  }

  if (!img || img.complete) {
    startWhenReady();
  } else {
    img.addEventListener('load',  startWhenReady, { once: true });
    img.addEventListener('error', startWhenReady, { once: true });
  }

})();
</script>

{% schema %}
{
  "name": "Avion Motion Hero",
  "tag": "div",
  "class": "avion-motion-hero",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "info": "Desert illustration. Recommended: 1920×1080 WebP or JPEG."
    },
    {
      "type": "text",
      "id": "bg_url",
      "label": "Background URL (fallback)",
      "info": "Paste a Shopify CDN URL if you prefer not to use the image picker above."
    },
    {
      "type": "header",
      "content": "Animated Plane"
    },
    {
      "type": "image_picker",
      "id": "plane_image",
      "label": "Plane illustration",
      "info": "The cartoon plane PNG (transparent background). Faces right."
    },
    {
      "type": "text",
      "id": "plane_url",
      "label": "Plane URL (fallback)"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Revealed after the plane animation. Transparent PNG recommended."
    },
    {
      "type": "text",
      "id": "logo_url",
      "label": "Logo URL (fallback)"
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Show scroll hint",
      "default": true
    },
    {
      "type": "color",
      "id": "bridge_color",
      "label": "Bottom fade color",
      "default": "#1a1a1a",
      "info": "The color the hero fades into at the bottom. Match the background of your next section."
    }
  ],
  "presets": [
    {
      "name": "Avion Motion Hero",
      "settings": {
        "show_scroll_hint": true,
        "bridge_color": "#1a1a1a"
      }
    }
  ]
}
{% endschema %}
