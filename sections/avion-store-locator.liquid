    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Find an authorized Avion retailer near you. Our products are available at select licensed dispensaries across Minnesota."
    },
    {
      "type": "text",
      "id": "google_maps_api_key",
      "label": "Google Maps API key",
      "info": "Optional. Add a Google Maps JavaScript API key to render the map with Google Maps. When empty, the section uses an interactive OpenStreetMap (Leaflet) map — no key required."
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "text",
          "id": "store_name",
          "label": "Store name"
        },
        {
          "type": "text",
          "id": "address_line_1",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "city_state_zip",
          "label": "City, state, ZIP"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "url",
          "id": "maps_embed_url",
          "label": "Maps URL"
        }
      ]
    }
  ],
  "presets": [
