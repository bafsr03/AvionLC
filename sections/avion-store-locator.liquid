{%- liquid
  assign av_rows = av_retailer_rows | split: '~'
  assign av_count = 0
  assign av_city_list = ''
  for row in av_rows
    assign r = row | strip
    if r == blank
      continue
    endif
    assign f = r | split: '|'
    assign av_count = av_count | plus: 1
    assign av_city_list = av_city_list | append: f[2] | append: '|'
  endfor
  assign av_cities = av_city_list | split: '|' | uniq | sort
-%}

<script type="application/json" id="avLocatorStores">
[
{%- assign av_i = 0 -%}
{%- for row in av_rows -%}
  {%- assign r = row | strip -%}
  {%- if r == blank -%}{%- continue -%}{%- endif -%}
  {%- assign f = r | split: '|' -%}
  {%- if av_i > 0 -%},{%- endif -%}
  {%- assign av_i = av_i | plus: 1 %}
  {"name":{{ f[0] | json }},"street":{{ f[1] | json }},"city":{{ f[2] | json }},"zip":{{ f[3] | json }},"phone":{{ f[4] | default: '' | json }},"web":{{ f[5] | default: '' | json }},"ig":{{ f[6] | default: '' | json }},"lat":{{ f[7] | default: 'null' }},"lng":{{ f[8] | default: 'null' }}}
{%- endfor %}
]
</script>

{%- comment -%} Store structured data: tells search engines which Minnesota
  dispensaries carry Avió, linked back to the brand's Organization entity. {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Authorized Avió Supply Co retailers in Minnesota",
  "numberOfItems": {{ av_count }},
  "itemListElement": [
  {%- assign av_i = 0 -%}
  {%- for row in av_rows -%}
    {%- assign r = row | strip -%}
    {%- if r == blank -%}{%- continue -%}{%- endif -%}
    {%- assign f = r | split: '|' -%}
    {%- if av_i > 0 -%},{%- endif -%}
    {%- assign av_i = av_i | plus: 1 %}
    {
      "@type": "ListItem",
      "position": {{ av_i }},
      "item": {
        "@type": "Store",
        "name": {{ f[0] | json }},
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ f[1] | json }},
          "addressLocality": {{ f[2] | json }},
          "addressRegion": "MN",
          "postalCode": {{ f[3] | json }},
          "addressCountry": "US"
        },
        {%- if f[4] != blank %}
        "telephone": {{ f[4] | strip | replace: ' ', '-' | prepend: '+1-' | json }},
        {%- endif -%}
        {%- if f[5] != blank %}
        "url": {{ f[5] | strip | prepend: 'https://' | json }},
        {%- endif -%}
        {%- if f[6] != blank -%}
          {%- assign av_handles = f[6] | split: ',' %}
        "sameAs": [
          {%- for h in av_handles -%}
            {{ h | strip | remove: '@' | prepend: 'https://www.instagram.com/' | append: '/' | json }}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        {%- endif %}
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": {{ f[7] }},
          "longitude": {{ f[8] }}
        },
        "brand": { "@id": {{ shop.url | append: '/#organization' | json }} }
      }
    }
  {%- endfor %}
  ]
}
</script>

<section class="av-locator" id="StoreLocator">

  <!-- HERO -->
  <div class="av-locator__hero" id="avLocatorHero">
    <div class="av-locator__hero-glyph" aria-hidden="true">L</div>
    <div class="av-locator__hero-inner">
      <p class="av-locator__hero-eyebrow">Retail locations</p>
      <h1 class="av-locator__hero-title">
        {{ section.settings.heading | default: 'WHERE TO FIND US' }}
      </h1>
      <div class="av-locator__hero-row">
        <p class="av-locator__hero-tagline">
          {{ section.settings.tagline | default: 'Find an authorized Avion retailer near you. Our products are available at select licensed dispensaries across Minnesota.' }}
        </p>
        <p class="av-locator__hero-count" aria-hidden="true">
          <span class="av-locator__hero-count-num" id="avLocatorCount" data-target="{{ av_count }}">0</span>&nbsp;locations
        </p>
      </div>
    </div>
  </div>

  <!-- BODY: fixed-height two-column -->
  <div class="av-locator__body">

    <!-- LEFT: list with search + scrollable cards -->
    <div class="av-locator__list">

      <p class="av-locator__list-label">Authorized retailers</p>

      <!-- Search + city pills, contained within the list column -->
      <div class="av-locator__list-controls">
        <div class="av-locator__search-wrap">
          <svg class="av-locator__search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input
            type="search"
            id="avLocatorSearch"
            class="av-locator__search-input"
            placeholder="Search by name or city…"
            aria-label="Search retailers"
            autocomplete="off"
          >
          <button class="av-locator__search-clear" id="avLocatorSearchClear" aria-label="Clear search" hidden>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="av-locator__city-wrap">
          <div class="av-locator__city-filters" id="avLocatorCityFilters" role="group" aria-label="Filter by city">
            <button class="av-locator__city-pill av-locator__city-pill--active" data-city="">All</button>
            {%- for city in av_cities -%}
              {%- if city != blank -%}
                <button class="av-locator__city-pill" data-city="{{ city | escape }}">{{ city | escape }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <!-- Scrollable card list -->
      <div class="av-locator__cards-scroll">
        <div id="avLocatorCards">
          {%- assign av_i = 0 -%}
          {%- for row in av_rows -%}
            {%- assign r = row | strip -%}
            {%- if r == blank -%}{%- continue -%}{%- endif -%}
            {%- assign f = r | split: '|' -%}
            {%- capture av_addr -%}{{ f[1] }}, {{ f[2] }}, MN {{ f[3] }}{%- endcapture -%}
            {%- capture av_dest -%}{{ f[1] }} {{ f[2] }} MN {{ f[3] }}{%- endcapture -%}
            <div class="av-locator__card" data-store-index="{{ av_i }}" data-location-name="{{ f[0] | escape }}" data-location-addr="{{ av_addr | escape }}">
              <div class="av-locator__card-header">
                <h3 class="av-locator__card-name">{{ f[0] | escape }}</h3>
                <span class="av-locator__card-city-tag">{{ f[2] | escape }}</span>
              </div>
              <p class="av-locator__card-address">{{ f[1] | escape }}<br>{{ f[2] | escape }}, MN {{ f[3] | escape }}</p>
              {%- if f[4] != blank -%}
                <p class="av-locator__card-phone"><a class="av-locator__card-phone-link" href="tel:{{ f[4] | remove: ' ' }}"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.44 12 19.79 19.79 0 0 1 1.35 3.35 2 2 0 0 1 3.32 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.38a16 16 0 0 0 6 6l.76-.76a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.28 16v.92z"/></svg>{{ f[4] | escape }}</a></p>
              {%- endif -%}
              {%- if f[5] != blank or f[6] != blank -%}
                <div class="av-locator__card-links">
                  {%- if f[5] != blank -%}
                    <a class="av-locator__card-link" href="https://{{ f[5] | escape }}" target="_blank" rel="noopener noreferrer"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>{{ f[5] | escape }}</a>
                  {%- endif -%}
                  {%- if f[6] != blank -%}
                    {%- assign av_handles = f[6] | split: ',' -%}
                    {%- for h in av_handles -%}
                      {%- assign av_h = h | strip | remove: '@' -%}
                      {%- if av_h != blank -%}
                        <a class="av-locator__card-link" href="https://www.instagram.com/{{ av_h | escape }}/" target="_blank" rel="noopener noreferrer"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>@{{ av_h | escape }}</a>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
              <a class="av-locator__card-directions" href="https://www.google.com/maps/dir/?api=1&amp;destination={{ av_dest | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Get directions to {{ f[0] | escape }}">Get directions<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
            </div>
            {%- assign av_i = av_i | plus: 1 -%}
          {%- endfor -%}
        </div>
        <p class="av-locator__empty" id="avLocatorEmpty" hidden>No matching locations found.</p>
      </div>

    </div>

    <!-- RIGHT: map panel, fills column height -->
    <div class="av-locator__map-panel" aria-label="Store location map">
      <div class="av-locator__map-wrap" id="avLocatorMapWrap">
        <div class="av-locator__leaflet" id="avLocatorLeafletMap" role="application" aria-label="Interactive map of authorized Avió retailers"></div>
        <div class="av-locator__map-google" id="avLocatorGoogleMap" aria-label="Interactive Google map of retailers"></div>
        <div class="av-locator__map-label" id="avLocatorMapLabel">
          <div>
            <p class="av-locator__map-label-name" id="avLocatorMapLabelName"></p>
            <p class="av-locator__map-label-addr" id="avLocatorMapLabelAddr"></p>
          </div>
        </div>
      </div>
    </div>

  </div>

</section>

<script>
(function () {
  'use strict';

  var stores = JSON.parse(document.getElementById('avLocatorStores').textContent);
  var googleMapsApiKey = {{ section.settings.google_maps_api_key | json }};
  /* State view: roughly centers on Minnesota with enough zoom-out to fit all pins,
     from Rush City in the north to Le Roy in the south. */
  var stateView = { lat: 45.0, lng: -93.5, zoom: 7 };
  var selectedZoom = 13;

  var activeIndex  = -1;
  var activeCity   = '';
  var searchQuery  = '';

  var cardsContainer = document.getElementById('avLocatorCards');
  var emptyEl        = document.getElementById('avLocatorEmpty');
  var mapWrap        = document.getElementById('avLocatorMapWrap');
  var leafletEl      = document.getElementById('avLocatorLeafletMap');
  var googleMapEl    = document.getElementById('avLocatorGoogleMap');
  var labelName      = document.getElementById('avLocatorMapLabelName');
  var labelAddr      = document.getElementById('avLocatorMapLabelAddr');
  var searchInput    = document.getElementById('avLocatorSearch');
  var searchClear    = document.getElementById('avLocatorSearchClear');
  var cityFilters    = document.getElementById('avLocatorCityFilters');

  function enc(s) { return encodeURIComponent(s); }

  function escHtml(s) {
    return String(s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function dirUrl(s) {
    return 'https://www.google.com/maps/dir/?api=1&destination=' + enc(s.street + ' ' + s.city + ' MN ' + s.zip);
  }

  function storesWithCoords(list) {
    return list.filter(function (s) { return typeof s.lat === 'number' && typeof s.lng === 'number'; });
  }

  /* ============================================================
     Leaflet + OpenStreetMap (default — no API key required)
     ============================================================ */
  var leafletScriptStarted = false;
  var leafletPending = [];

  function withLeaflet(callback) {
    if (window.L) { callback(); return; }
    leafletPending.push(callback);
    if (leafletScriptStarted) return;
    leafletScriptStarted = true;

    if (!document.getElementById('avLocatorLeafletCss')) {
      var link = document.createElement('link');
      link.id = 'avLocatorLeafletCss';
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      link.crossOrigin = '';
      document.head.appendChild(link);
    }

    var script = document.createElement('script');
    script.id = 'avLocatorLeafletJs';
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.crossOrigin = '';
    script.onload = function () {
      var queued = leafletPending.slice();
      leafletPending = [];
      queued.forEach(function (fn) { fn(); });
    };
    document.head.appendChild(script);
  }

  var leafletMap;
  var leafletMarkers = [];

  function makePinIcon(active) {
    return L.divIcon({
      className: 'av-locator__leaflet-pin-icon' + (active ? ' av-locator__leaflet-pin-icon--active' : ''),
      html: '<span class="av-locator__leaflet-pin-shape"></span>',
      iconSize: [18, 18],
      iconAnchor: [9, 18],
      popupAnchor: [0, -16]
    });
  }

  function initLeafletMap() {
    if (leafletMap || !leafletEl) return;

    leafletMap = L.map(leafletEl, {
      center: [stateView.lat, stateView.lng],
      zoom: stateView.zoom,
      minZoom: 4,
      maxZoom: 17,
      scrollWheelZoom: false,
      zoomControl: true
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18
    }).addTo(leafletMap);

    /* Re-enable wheel zoom only after a click, so the map doesn't hijack page scroll. */
    leafletMap.on('click focus', function () { leafletMap.scrollWheelZoom.enable(); });
    leafletMap.on('mouseout', function () { leafletMap.scrollWheelZoom.disable(); });

    stores.forEach(function (store, index) {
      if (typeof store.lat !== 'number') return;

      var marker = L.marker([store.lat, store.lng], {
        icon: makePinIcon(false),
        title: store.name,
        riseOnHover: true
      });

      marker.bindPopup(
        '<strong>' + escHtml(store.name) + '</strong>' +
        escHtml(store.street) + '<br>' +
        escHtml(store.city) + ', MN ' + escHtml(store.zip)
      );

      marker.on('click', function () {
        activeIndex = index;
        highlightCard(index, true);
        setActiveLeafletMarker(index);
        if (labelName) labelName.textContent = store.name;
        if (labelAddr) labelAddr.textContent = store.street + ', ' + store.city + ', MN ' + store.zip;
      });

      marker.addTo(leafletMap);
      leafletMarkers[index] = marker;
    });
  }

  function setActiveLeafletMarker(idx) {
    leafletMarkers.forEach(function (m, i) {
      if (!m) return;
      m.setIcon(makePinIcon(i === idx));
    });
  }

  function applyLeafletView() {
    if (!leafletMap) return;

    var filtered = getFiltered();
    var visibleIdx = {};
    filtered.forEach(function (s) { visibleIdx[stores.indexOf(s)] = true; });

    stores.forEach(function (s, i) {
      var marker = leafletMarkers[i];
      if (!marker) return;
      var shouldShow = visibleIdx[i] || i === activeIndex;
      if (shouldShow) {
        if (!leafletMap.hasLayer(marker)) marker.addTo(leafletMap);
      } else if (leafletMap.hasLayer(marker)) {
        leafletMap.removeLayer(marker);
      }
    });

    setActiveLeafletMarker(activeIndex);

    if (activeIndex >= 0 && leafletMarkers[activeIndex]) {
      leafletMap.setView(leafletMarkers[activeIndex].getLatLng(), selectedZoom, { animate: true });
      leafletMarkers[activeIndex].openPopup();
      return;
    }

    leafletMap.closePopup();

    if (!activeCity && !searchQuery) {
      /* Overview: fit every retailer pin into view, capped so we still feel like a state map. */
      var allCoords = storesWithCoords(stores);
      if (allCoords.length > 1) {
        leafletMap.fitBounds(L.latLngBounds(allCoords.map(function (s) { return [s.lat, s.lng]; })), {
          padding: [40, 40],
          maxZoom: 8
        });
      } else {
        leafletMap.setView([stateView.lat, stateView.lng], stateView.zoom, { animate: true });
      }
      return;
    }

    var coords = storesWithCoords(filtered);
    if (coords.length === 0) {
      leafletMap.setView([stateView.lat, stateView.lng], stateView.zoom, { animate: true });
    } else if (coords.length === 1) {
      leafletMap.setView([coords[0].lat, coords[0].lng], 12, { animate: true });
    } else {
      leafletMap.fitBounds(L.latLngBounds(coords.map(function (s) { return [s.lat, s.lng]; })), {
        padding: [50, 50],
        maxZoom: 12
      });
    }
  }

  /* ============================================================
     Google Maps JS API (optional — used when an API key is set)
     ============================================================ */
  var googleMap;
  var googleInfoWindow;
  var googleMarkers = [];
  var googleScriptStarted = false;
  var googlePending = [];

  function withGoogle(callback) {
    if (window.google && window.google.maps) { callback(); return; }
    googlePending.push(callback);
    if (googleScriptStarted) return;
    googleScriptStarted = true;

    window.avLocatorGoogleMapReady = function () {
      var queued = googlePending.slice();
      googlePending = [];
      queued.forEach(function (fn) { fn(); });
    };

    var script = document.createElement('script');
    script.id = 'avLocatorGoogleMapsScript';
    script.async = true;
    script.defer = true;
    script.src = 'https://maps.googleapis.com/maps/api/js?key=' + enc(googleMapsApiKey) + '&callback=avLocatorGoogleMapReady';
    document.head.appendChild(script);
  }

  function initGoogleMap() {
    if (googleMap || !googleMapEl || !(window.google && window.google.maps)) return;

    mapWrap.classList.add('av-locator__map-wrap--google');

    googleMap = new google.maps.Map(googleMapEl, {
      center: { lat: stateView.lat, lng: stateView.lng },
      zoom: stateView.zoom,
      mapTypeControl: false,
      streetViewControl: false,
      fullscreenControl: true
    });
    googleInfoWindow = new google.maps.InfoWindow();

    stores.forEach(function (store, index) {
      if (typeof store.lat !== 'number') return;

      var marker = new google.maps.Marker({
        map: googleMap,
        position: { lat: store.lat, lng: store.lng },
        title: store.name
      });

      marker.addListener('click', function () {
        activeIndex = index;
        highlightCard(index, true);
        openGoogleInfo(store, marker);
        if (labelName) labelName.textContent = store.name;
        if (labelAddr) labelAddr.textContent = store.street + ', ' + store.city + ', MN ' + store.zip;
      });

      googleMarkers[index] = marker;
    });
  }

  function openGoogleInfo(store, marker) {
    if (!googleInfoWindow || !marker) return;
    googleInfoWindow.setContent(
      '<strong>' + escHtml(store.name) + '</strong><br>' +
      escHtml(store.street) + '<br>' +
      escHtml(store.city) + ', MN ' + escHtml(store.zip)
    );
    googleInfoWindow.open(googleMap, marker);
  }

  function applyGoogleView() {
    if (!googleMap) return;

    var filtered = getFiltered();
    var visibleIdx = {};
    filtered.forEach(function (s) { visibleIdx[stores.indexOf(s)] = true; });

    var bounds = new google.maps.LatLngBounds();
    var visibleCount = 0;
    var lastVisible = -1;

    stores.forEach(function (s, i) {
      var marker = googleMarkers[i];
      if (!marker) return;
      var visible = visibleIdx[i] || i === activeIndex;
      marker.setVisible(visible);
      if (visible) {
        bounds.extend(marker.getPosition());
        visibleCount++;
        lastVisible = i;
      }
    });

    if (activeIndex >= 0 && googleMarkers[activeIndex]) {
      googleMap.setZoom(selectedZoom);
      googleMap.panTo(googleMarkers[activeIndex].getPosition());
      openGoogleInfo(stores[activeIndex], googleMarkers[activeIndex]);
      return;
    }

    if (googleInfoWindow) googleInfoWindow.close();

    if (!activeCity && !searchQuery) {
      var allBounds = new google.maps.LatLngBounds();
      storesWithCoords(stores).forEach(function (s) {
        allBounds.extend(new google.maps.LatLng(s.lat, s.lng));
      });
      if (!allBounds.isEmpty()) {
        googleMap.fitBounds(allBounds, { top: 60, right: 60, bottom: 100, left: 60 });
      } else {
        googleMap.setCenter({ lat: stateView.lat, lng: stateView.lng });
        googleMap.setZoom(stateView.zoom);
      }
      return;
    }

    if (visibleCount === 1 && lastVisible >= 0) {
      googleMap.setZoom(12);
      googleMap.panTo(googleMarkers[lastVisible].getPosition());
    } else if (visibleCount > 1) {
      googleMap.fitBounds(bounds, { top: 60, right: 60, bottom: 100, left: 60 });
    } else {
      googleMap.setCenter({ lat: stateView.lat, lng: stateView.lng });
      googleMap.setZoom(stateView.zoom);
    }
  }

  /* ============================================================
     Map refresh dispatcher + label
     ============================================================ */
  function updateOverviewLabel() {
    var filtered = getFiltered();
    var total = filtered.length;
    var word = total === 1 ? 'location' : 'locations';
    var title = activeCity ? activeCity + ' retailers' : (searchQuery ? 'Matching retailers' : 'Minnesota retailers');
    if (labelName) labelName.textContent = total ? title : 'No matching locations';
    if (labelAddr) labelAddr.textContent = total + ' authorized ' + word;
  }

  function updateSelectedLabel() {
    var s = stores[activeIndex];
    if (!s) return;
    if (labelName) labelName.textContent = s.name;
    if (labelAddr) labelAddr.textContent = s.street + ', ' + s.city + ', MN ' + s.zip;
  }

  /* Load the map library only once the map panel is near the viewport,
     so it doesn't compete with the page's first paint. */
  var mapInView = !('IntersectionObserver' in window);
  if (!mapInView) {
    new IntersectionObserver(function (entries, obs) {
      if (!entries.some(function (e) { return e.isIntersecting; })) return;
      obs.disconnect();
      mapInView = true;
      refreshMap();
    }, { rootMargin: '300px 0px' }).observe(mapWrap);
  }

  function refreshMap() {
    if (activeIndex >= 0) updateSelectedLabel();
    else updateOverviewLabel();

    if (!mapInView) return;

    if (googleMapsApiKey) {
      withGoogle(function () {
        initGoogleMap();
        applyGoogleView();
      });
      return;
    }

    withLeaflet(function () {
      initLeafletMap();
      /* Force a size recalc in case the section was offscreen / animating in. */
      requestAnimationFrame(function () {
        if (leafletMap) leafletMap.invalidateSize();
        applyLeafletView();
      });
    });
  }

  function highlightCard(storeIndex, scrollCard) {
    cardsContainer.querySelectorAll('.av-locator__card').forEach(function (card) {
      card.classList.toggle('av-locator__card--active', parseInt(card.dataset.storeIndex, 10) === storeIndex);
    });

    if (scrollCard) {
      var card = cardsContainer.querySelector('[data-store-index="' + storeIndex + '"]');
      if (card && card.scrollIntoView) card.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
  }

  /* ---- Card HTML ---- */
  function buildCard(store, storeIndex) {
    var addr = store.street + ', ' + store.city + ', MN ' + store.zip;

    var phoneHtml = store.phone
      ? '<p class="av-locator__card-phone">'
          + '<a class="av-locator__card-phone-link" href="tel:' + store.phone.replace(/\s/g, '') + '">'
          + '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.44 12 19.79 19.79 0 0 1 1.35 3.35 2 2 0 0 1 3.32 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.38a16 16 0 0 0 6 6l.76-.76a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.28 16v.92z"/></svg>'
          + escHtml(store.phone)
          + '</a></p>'
      : '';

    var linkItems = [];
    if (store.web) {
      linkItems.push(
        '<a class="av-locator__card-link" href="https://' + escHtml(store.web) + '" target="_blank" rel="noopener noreferrer">'
        + '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>'
        + escHtml(store.web) + '</a>'
      );
    }
    (store.ig ? store.ig.split(',') : []).forEach(function (rawHandle) {
      var h = rawHandle.trim().replace(/^@/, '');
      if (!h) return;
      linkItems.push(
        '<a class="av-locator__card-link" href="https://www.instagram.com/' + escHtml(h) + '/" target="_blank" rel="noopener noreferrer">'
        + '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>'
        + '@' + escHtml(h) + '</a>'
      );
    });
    var linksHtml = linkItems.length
      ? '<div class="av-locator__card-links">' + linkItems.join('') + '</div>'
      : '';

    return '<div class="av-locator__card"'
      + ' data-store-index="' + storeIndex + '"'
      + ' data-location-name="' + escHtml(store.name) + '"'
      + ' data-location-addr="' + escHtml(addr) + '">'
      + '<div class="av-locator__card-header">'
        + '<h3 class="av-locator__card-name">' + escHtml(store.name) + '</h3>'
        + '<span class="av-locator__card-city-tag">' + escHtml(store.city) + '</span>'
      + '</div>'
      + '<p class="av-locator__card-address">' + escHtml(store.street) + '<br>' + escHtml(store.city) + ', MN ' + escHtml(store.zip) + '</p>'
      + phoneHtml
      + linksHtml
      + '<a class="av-locator__card-directions" href="' + escHtml(dirUrl(store)) + '" target="_blank" rel="noopener noreferrer" aria-label="Get directions to ' + escHtml(store.name) + '">'
        + 'Get directions'
        + '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>'
      + '</a>'
      + '</div>';
  }

  /* ---- Filter + render ---- */
  function getFiltered() {
    return stores.filter(function (s) {
      var matchCity   = !activeCity   || s.city.toLowerCase() === activeCity.toLowerCase();
      var matchSearch = !searchQuery
        || s.name.toLowerCase().indexOf(searchQuery)   !== -1
        || s.city.toLowerCase().indexOf(searchQuery)   !== -1
        || s.street.toLowerCase().indexOf(searchQuery) !== -1;
      return matchCity && matchSearch;
    });
  }

  function renderCards() {
    var filtered = getFiltered();
    cardsContainer.innerHTML = filtered.map(function (s) {
      return buildCard(s, stores.indexOf(s));
    }).join('');
    emptyEl.hidden = filtered.length > 0;

    var cards = cardsContainer.querySelectorAll('.av-locator__card');

    /* Staggered scroll-reveal via IntersectionObserver */
    var revealObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('av-locator__card--in');
          revealObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.05, root: document.querySelector('.av-locator__cards-scroll') });

    cards.forEach(function (card, i) {
      card.style.setProperty('--stagger', (i * 50) + 'ms');
      revealObs.observe(card);
      card.addEventListener('click', onCardClick);
    });

    /* Keep a selected store only when it is still visible; otherwise return to the overview. */
    if (activeIndex >= 0) {
      var ac = cardsContainer.querySelector('[data-store-index="' + activeIndex + '"]');
      if (ac) {
        ac.classList.add('av-locator__card--active');
      } else {
        activeIndex = -1;
      }
    }

    refreshMap();
  }

  /* ---- Activate ---- */
  function activateCard(card) {
    cardsContainer.querySelectorAll('.av-locator__card').forEach(function (c) {
      c.classList.remove('av-locator__card--active');
    });
    card.classList.add('av-locator__card--active');
    activeIndex = parseInt(card.dataset.storeIndex, 10);
    refreshMap();
  }

  function onCardClick(e) {
    if (e.target.closest('a')) return;
    activateCard(this);
  }

  /* ---- City pills ---- */
  function buildCityFilters() {
    var cities = [];
    stores.forEach(function (s) {
      if (cities.indexOf(s.city) === -1) cities.push(s.city);
    });
    cities.sort();

    var html = '<button class="av-locator__city-pill av-locator__city-pill--active" data-city="">All</button>';
    cities.forEach(function (city) {
      html += '<button class="av-locator__city-pill" data-city="' + escHtml(city) + '">' + escHtml(city) + '</button>';
    });
    cityFilters.innerHTML = html;

    cityFilters.addEventListener('click', function (e) {
      var pill = e.target.closest('.av-locator__city-pill');
      if (!pill) return;
      cityFilters.querySelectorAll('.av-locator__city-pill').forEach(function (p) {
        p.classList.remove('av-locator__city-pill--active');
      });
      pill.classList.add('av-locator__city-pill--active');
      activeCity = pill.dataset.city;
      activeIndex = -1;
      renderCards();
    });
  }

  /* ---- Search ---- */
  searchInput.addEventListener('input', function () {
    searchQuery = this.value.trim().toLowerCase();
    searchClear.hidden = !searchQuery;
    if (searchQuery) {
      activeCity = '';
      cityFilters.querySelectorAll('.av-locator__city-pill').forEach(function (p) {
        p.classList.toggle('av-locator__city-pill--active', p.dataset.city === '');
      });
    }
    activeIndex = -1;
    renderCards();
  });

  searchClear.addEventListener('click', function () {
    searchInput.value = '';
    searchQuery = '';
    searchClear.hidden = true;
    activeIndex = -1;
    renderCards();
    searchInput.focus();
  });

  /* ---- Animated counter ---- */
  function animateCounter(el, target, duration) {
    var start = null;
    (function step(ts) {
      if (!start) start = ts;
      var p = Math.min((ts - start) / duration, 1);
      el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target);
      if (p < 1) requestAnimationFrame(step);
    })(performance.now());
  }

  /* ---- Hero entrance + counter ---- */
  var heroEl      = document.getElementById('avLocatorHero');
  var counterEl   = document.getElementById('avLocatorCount');
  var counterDone = false;

  new IntersectionObserver(function (entries, obs) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      heroEl.classList.add('av-locator__hero--visible');
      if (!counterDone && counterEl) {
        counterDone = true;
        setTimeout(function () {
          animateCounter(counterEl, parseInt(counterEl.dataset.target, 10) || 60, 1400);
        }, 480);
      }
      obs.unobserve(heroEl);
    });
  }, { threshold: 0.15 }).observe(heroEl);

  /* ---- Init ---- */
  buildCityFilters();
  renderCards();

})();
</script>

{% schema %}
{
  "name": "Store Locator",
  "tag": "section",
