<section class="av-locator" id="StoreLocator">

  <!-- HERO -->
  <div class="av-locator__hero" id="avLocatorHero">
    <div class="av-locator__hero-glyph" aria-hidden="true">L</div>
    <div class="av-locator__hero-inner">
      <p class="av-locator__hero-eyebrow">Retail locations</p>
      <h2 class="av-locator__hero-title">
        {{ section.settings.heading | default: 'WHERE TO FIND US' }}
      </h2>
      <div class="av-locator__hero-row">
        <p class="av-locator__hero-tagline">
          {{ section.settings.tagline | default: 'Find an authorized Avion retailer near you. Our products are available at select licensed dispensaries across Minnesota.' }}
        </p>
        <p class="av-locator__hero-count" aria-hidden="true">
          <span class="av-locator__hero-count-num" id="avLocatorCount" data-target="27">0</span>&nbsp;locations
        </p>
      </div>
    </div>
  </div>

  <!-- BODY: fixed-height two-column -->
  <div class="av-locator__body">

    <!-- LEFT: list with search + scrollable cards -->
    <div class="av-locator__list">

      <p class="av-locator__list-label">Authorized retailers</p>

      <!-- Search + city pills, contained within the list column -->
      <div class="av-locator__list-controls">
        <div class="av-locator__search-wrap">
          <svg class="av-locator__search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input
            type="search"
            id="avLocatorSearch"
            class="av-locator__search-input"
            placeholder="Search by name or city…"
            aria-label="Search retailers"
            autocomplete="off"
          >
          <button class="av-locator__search-clear" id="avLocatorSearchClear" aria-label="Clear search" hidden>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="av-locator__city-wrap">
          <div class="av-locator__city-filters" id="avLocatorCityFilters" role="group" aria-label="Filter by city"></div>
        </div>
      </div>

      <!-- Scrollable card list -->
      <div class="av-locator__cards-scroll">
        <div id="avLocatorCards"></div>
        <p class="av-locator__empty" id="avLocatorEmpty" hidden>No matching locations found.</p>
      </div>

    </div>

    <!-- RIGHT: map panel, fills column height -->
    <div class="av-locator__map-panel" aria-label="Store location map">
      <div class="av-locator__map-wrap" id="avLocatorMapWrap">
        <iframe
          class="av-locator__map-iframe"
          id="avLocatorMap"
          src=""
          title="Store location map"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <div class="av-locator__map-label" id="avLocatorMapLabel">
          <div>
            <p class="av-locator__map-label-name" id="avLocatorMapLabelName"></p>
            <p class="av-locator__map-label-addr" id="avLocatorMapLabelAddr"></p>
          </div>
        </div>
      </div>
    </div>

  </div>

</section>

<script>
(function () {
  'use strict';

  var stores = JSON.parse(document.getElementById('avLocatorStores').textContent);
  var activeIndex  = -1;
  var activeCity   = '';
  var searchQuery  = '';

  var cardsContainer = document.getElementById('avLocatorCards');
  var emptyEl        = document.getElementById('avLocatorEmpty');
  var mapIframe      = document.getElementById('avLocatorMap');
  var labelName      = document.getElementById('avLocatorMapLabelName');
  var labelAddr      = document.getElementById('avLocatorMapLabelAddr');
  var searchInput    = document.getElementById('avLocatorSearch');
  var searchClear    = document.getElementById('avLocatorSearchClear');
  var cityFilters    = document.getElementById('avLocatorCityFilters');

  function enc(s) { return encodeURIComponent(s); }

  function escHtml(s) {
    return String(s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function mapSrc(s) {
    var q = enc(s.street + ', ' + s.city + ', MN ' + s.zip);
    return 'https://maps.google.com/maps?q=' + q + '&output=embed&hl=en&z=15';
  }

  function dirUrl(s) {
    var q = enc(s.street + ' ' + s.city + ' MN ' + s.zip);
    return 'https://www.google.com/maps/dir/?api=1&destination=' + q;
  }

  /* ---- Card HTML ---- */
  function buildCard(store, storeIndex) {
    var addr = store.street + ', ' + store.city + ', MN ' + store.zip;

    var phoneHtml = store.phone
      ? '<p class="av-locator__card-phone">'
          + '<a class="av-locator__card-phone-link" href="tel:' + store.phone.replace(/\s/g, '') + '">'
          + '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.44 12 19.79 19.79 0 0 1 1.35 3.35 2 2 0 0 1 3.32 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.38a16 16 0 0 0 6 6l.76-.76a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.28 16v.92z"/></svg>'
          + escHtml(store.phone)
          + '</a></p>'
      : '';

    var linkItems = [];
    if (store.web) {
      linkItems.push(
        '<a class="av-locator__card-link" href="https://' + escHtml(store.web) + '" target="_blank" rel="noopener noreferrer">'
        + '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>'
        + escHtml(store.web) + '</a>'
      );
    }
    if (store.ig) {
      var h = store.ig.replace(/^@/, '');
      linkItems.push(
        '<a class="av-locator__card-link" href="https://www.instagram.com/' + escHtml(h) + '/" target="_blank" rel="noopener noreferrer">'
        + '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>'
        + '@' + escHtml(h) + '</a>'
      );
    }
    var linksHtml = linkItems.length
      ? '<div class="av-locator__card-links">' + linkItems.join('') + '</div>'
      : '';

    return '<div class="av-locator__card"'
      + ' data-store-index="' + storeIndex + '"'
      + ' data-map-src="' + escHtml(mapSrc(store)) + '"'
      + ' data-location-name="' + escHtml(store.name) + '"'
      + ' data-location-addr="' + escHtml(addr) + '">'
      + '<div class="av-locator__card-header">'
        + '<h3 class="av-locator__card-name">' + escHtml(store.name) + '</h3>'
        + '<span class="av-locator__card-city-tag">' + escHtml(store.city) + '</span>'
      + '</div>'
      + '<p class="av-locator__card-address">' + escHtml(store.street) + '<br>' + escHtml(store.city) + ', MN ' + escHtml(store.zip) + '</p>'
      + phoneHtml
      + linksHtml
      + '<a class="av-locator__card-directions" href="' + escHtml(dirUrl(store)) + '" target="_blank" rel="noopener noreferrer" aria-label="Get directions to ' + escHtml(store.name) + '">'
        + 'Get directions'
        + '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>'
      + '</a>'
      + '</div>';
  }

  /* ---- Filter + render ---- */
  function getFiltered() {
    return stores.filter(function (s) {
      var matchCity   = !activeCity   || s.city.toLowerCase() === activeCity.toLowerCase();
      var matchSearch = !searchQuery
        || s.name.toLowerCase().indexOf(searchQuery)   !== -1
        || s.city.toLowerCase().indexOf(searchQuery)   !== -1
        || s.street.toLowerCase().indexOf(searchQuery) !== -1;
      return matchCity && matchSearch;
    });
  }

  function renderCards() {
    var filtered = getFiltered();
    cardsContainer.innerHTML = filtered.map(function (s) {
      return buildCard(s, stores.indexOf(s));
    }).join('');
    emptyEl.hidden = filtered.length > 0;

    var cards = cardsContainer.querySelectorAll('.av-locator__card');

    /* Staggered scroll-reveal via IntersectionObserver */
    var revealObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('av-locator__card--in');
          revealObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.05, root: document.querySelector('.av-locator__cards-scroll') });

    cards.forEach(function (card, i) {
      card.style.setProperty('--stagger', (i * 50) + 'ms');
      revealObs.observe(card);
      card.addEventListener('click', onCardClick);
    });

    /* Re-activate previously active store if still visible */
    if (activeIndex >= 0) {
      var ac = cardsContainer.querySelector('[data-store-index="' + activeIndex + '"]');
      if (ac) {
        ac.classList.add('av-locator__card--active');
      } else if (filtered.length > 0) {
        activateCard(cards[0]);
      }
    } else if (filtered.length > 0) {
      activateCard(cards[0]);
    }
  }

  /* ---- Activate ---- */
  function activateCard(card) {
    cardsContainer.querySelectorAll('.av-locator__card').forEach(function (c) {
      c.classList.remove('av-locator__card--active');
    });
    card.classList.add('av-locator__card--active');
    activeIndex = parseInt(card.dataset.storeIndex, 10);

    /* Fade map, swap src, fade back */
    mapIframe.classList.add('av-locator__map-iframe--fading');
    setTimeout(function () {
      var src = card.dataset.mapSrc;
      if (src && mapIframe.src !== src) mapIframe.src = src;
      if (labelName) labelName.textContent = card.dataset.locationName || '';
      if (labelAddr) labelAddr.textContent = card.dataset.locationAddr || '';
      mapIframe.classList.remove('av-locator__map-iframe--fading');
    }, 270);
  }

  function onCardClick(e) {
    if (e.target.closest('a')) return;
    activateCard(this);
  }

  /* ---- City pills ---- */
  function buildCityFilters() {
    var cities = [];
    stores.forEach(function (s) {
      if (cities.indexOf(s.city) === -1) cities.push(s.city);
    });
    cities.sort();

    var html = '<button class="av-locator__city-pill av-locator__city-pill--active" data-city="">All</button>';
    cities.forEach(function (city) {
      html += '<button class="av-locator__city-pill" data-city="' + escHtml(city) + '">' + escHtml(city) + '</button>';
    });
    cityFilters.innerHTML = html;

    cityFilters.addEventListener('click', function (e) {
      var pill = e.target.closest('.av-locator__city-pill');
      if (!pill) return;
      cityFilters.querySelectorAll('.av-locator__city-pill').forEach(function (p) {
        p.classList.remove('av-locator__city-pill--active');
      });
      pill.classList.add('av-locator__city-pill--active');
      activeCity = pill.dataset.city;
      activeIndex = -1;
      renderCards();
    });
  }

  /* ---- Search ---- */
  searchInput.addEventListener('input', function () {
    searchQuery = this.value.trim().toLowerCase();
    searchClear.hidden = !searchQuery;
    if (searchQuery) {
      activeCity = '';
      cityFilters.querySelectorAll('.av-locator__city-pill').forEach(function (p) {
        p.classList.toggle('av-locator__city-pill--active', p.dataset.city === '');
      });
    }
    activeIndex = -1;
    renderCards();
  });

  searchClear.addEventListener('click', function () {
    searchInput.value = '';
    searchQuery = '';
    searchClear.hidden = true;
    activeIndex = -1;
    renderCards();
    searchInput.focus();
  });

  /* ---- Animated counter ---- */
  function animateCounter(el, target, duration) {
    var start = null;
    (function step(ts) {
      if (!start) start = ts;
      var p = Math.min((ts - start) / duration, 1);
      el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target);
      if (p < 1) requestAnimationFrame(step);
    })(performance.now());
  }

  /* ---- Hero entrance + counter ---- */
  var heroEl      = document.getElementById('avLocatorHero');
  var counterEl   = document.getElementById('avLocatorCount');
  var counterDone = false;

  new IntersectionObserver(function (entries, obs) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      heroEl.classList.add('av-locator__hero--visible');
      if (!counterDone && counterEl) {
        counterDone = true;
        setTimeout(function () {
          animateCounter(counterEl, parseInt(counterEl.dataset.target, 10) || 27, 1400);
        }, 480);
      }
      obs.unobserve(heroEl);
    });
  }, { threshold: 0.15 }).observe(heroEl);

  /* ---- Init ---- */
  buildCityFilters();
  renderCards();

})();
</script>

{% schema %}
{
  "name": "Store Locator",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHERE TO FIND US"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Find an authorized Avion retailer near you. Our products are available at select licensed dispensaries across Minnesota."
    }
  ],
  "presets": [
    {
      "name": "Store Locator"
    }
  ]
}
{% endschema %}
