        </a>
      </p>
    </div>

  </div>

  <!-- Age gate notice -->
  <div class="av-footer__age-gate">
    {{ section.settings.legal_text | default: 'Avio Supply Co. products are intended for adults 21 and over. Cannabis products are not available in all areas. Check your local laws before purchasing.' }}
  </div>

</footer>

{% schema %}
{
  "name": "Avion Footer",
  "tag": "section",
  "class": "av-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "A legacy worth flying for."
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Brand sub-label",
      "default": "Oregon · Est. 2024"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About paragraph",
      "default": "Avio Supply Co. honors the story of Jerry Wilson — pilot, risk-taker, and advocate for cannabis freedom long before it was mainstream."
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal links menu",
      "default": "footer"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter description",
      "default": "Early access to drops, behind-the-scenes stories, and news from the legacy."
    },
    {
      "type": "text",
      "id": "age_notice",
      "label": "Age notice",
      "default": "21+ only. Please consume responsibly."
    },
    {
      "type": "textarea",
      "id": "legal_text",
      "label": "Legal disclaimer",
      "default": "Avio Supply Co. products are intended for adults 21 and over. Cannabis products are not available in all areas. Check your local laws before purchasing."
