{% style %}
  .avion-story-final-v15 {
    background-color: #FFF3DC;
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    /* Account for fixed/sticky header */
    padding-top: clamp(64px, 8vw, 88px);
    box-sizing: border-box;
  }

  .avion-story-final-v15::before {
    content: "";
    position: absolute;
    top:0; left:0; width:100%; height:100%;
    background-image: url("https://cdn.shopify.com/s/files/1/0905/4227/6792/files/banner-avion-herotransparent.png?v=1768421638");
    background-size: cover;
    opacity: 0.12;
    z-index: 1;
    pointer-events: none;
  }

  .avion-grid-v15 {
    display: grid;
    grid-template-columns: 1fr clamp(320px, 42%, 620px) 1fr;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    position: relative;
    z-index: 5;
    align-items: end;
  }

  /* COLUMNA JERRY: PEGADA AL FINAL */
  .jerry-col-v15 {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    line-height: 0;
  }

  .jerry-col-v15 img {
    width: 100%;
    height: auto;
    display: block;
    margin: 0;
    vertical-align: bottom;
  }


  .text-col-v15 {
    padding-top: 20px; 
    padding-bottom: 100px; 
    padding-left: 40px;
    padding-right: 40px;
    align-self: center; 
  }

  .avion-story-final-v15 h2 {
    font-family: "Young Serif", serif !important;
    font-size: clamp(2.5rem, 4.5vw, 4.5rem);
    line-height: 0.85;
    color: #3A3A3C;
    margin-bottom: 30px;

  }

  .avion-story-final-v15 p {
    font-family: "Source Serif 4", serif !important;
    font-size: 1.1rem;
    line-height: 1.5;
    color: #3A3A3C;
    margin-bottom: 25px;
  }

  /* reveal handled by avion-animations.js */

  @media (max-width: 1100px) {
    .avion-story-final-v15 {
      align-items: flex-start;
      padding-top: clamp(64px, 8vw, 88px);
    }
    .avion-grid-v15 {
      grid-template-columns: 1fr;
      padding: 20px 20px 0;
    }
    .jerry-col-v15 {
      order: -1;
      max-height: 55vw;
      overflow: hidden;
      align-items: flex-end;
    }
    .jerry-col-v15 img {
      max-height: 55vw;
      object-fit: cover;
      object-position: top;
    }
    .text-col-v15 {
      padding-top: 32px;
      padding-bottom: 40px;
      padding-left: 20px;
      padding-right: 20px;
      text-align: left;
    }
  }

  @media (max-width: 600px) {
    .avion-story-final-v15 h2 {
      font-size: clamp(2rem, 8vw, 3rem);
    }
    .avion-story-final-v15 p {
      font-size: 1rem;
    }
  }
{% endstyle %}

<section class="avion-story-final-v15">
  <div class="avion-grid-v15">
    
    <div class="text-col-v15">
      <h2
        data-av-reveal="words"
        data-av-delay="0"
      >{{ section.settings.title }}</h2>
      <div
        class="rte"
        data-av-reveal="fade-up"
        data-av-delay="400"
      >
        {{ section.settings.text_left }}
      </div>
    </div>

    <div
      class="jerry-col-v15"
      data-av-curtain
      data-av-curtain-color="#FFF3DC"
    >
      {% if section.settings.image_jerry != blank %}
        <img src="{{ section.settings.image_jerry | image_url: width: 1400 }}" alt="Jerry Wilson">
      {% endif %}
    </div>

    <div class="text-col-v15">
      <div
        class="rte"
        data-av-reveal="fade-up"
        data-av-delay="200"
      >
        {{ section.settings.text_right }}
      </div>
    </div>

  </div>
</section>


{% schema %}
{
  "name": "Avión Story Jerry Abajo",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "THE STORY" },
    { "type": "image_picker", "id": "image_jerry", "label": "Imagen Jerry" },
    { "type": "richtext", "id": "text_left", "label": "Texto Izquierda" },
    { "type": "richtext", "id": "text_right", "label": "Texto Derecha" }
  ],
  "presets": [{ "name": "Avión Story Jerry Abajo" }]
}
{% endschema %}