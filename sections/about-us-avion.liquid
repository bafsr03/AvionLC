{% style %}
  .avion-story-final-v15 {
    background-color: #FFF3DC;
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    align-items: flex-end; 
  }

  .avion-story-final-v15::before {
    content: "";
    position: absolute;
    top:0; left:0; width:100%; height:100%;
    background-image: url("https://cdn.shopify.com/s/files/1/0905/4227/6792/files/banner-avion-herotransparent.png?v=1768421638");
    background-size: cover;
    opacity: 0.12;
    z-index: 1;
    pointer-events: none;
  }

  .avion-grid-v15 {
    display: grid;
    grid-template-columns: 1fr 650px 1fr; 
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    position: relative;
    z-index: 5;
    align-items: end; 
  }

  /* COLUMNA JERRY: PEGADA AL FINAL */
  .jerry-col-v15 {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    line-height: 0;
  }

  .jerry-col-v15 img {
    width: 100%;
    height: auto;
    display: block;
    margin: 0;
    vertical-align: bottom;
  }


  .text-col-v15 {
    padding-top: 20px; 
    padding-bottom: 100px; 
    padding-left: 40px;
    padding-right: 40px;
    align-self: center; 
  }

  .avion-story-final-v15 h2 {
    font-family: "Young Serif", serif !important;
    font-size: clamp(2.5rem, 4.5vw, 4.5rem);
    line-height: 0.85;
    color: #3A3A3C;
    margin-bottom: 30px;

  }

  .avion-story-final-v15 p {
    font-family: "Source Serif 4", serif !important;
    font-size: 1.1rem;
    line-height: 1.5;
    color: #3A3A3C;
    margin-bottom: 25px;
  }

  .reveal-v15 {
    opacity: 0;
    transform: translateY(20px);
    transition: all 1s ease-out;
  }
  .reveal-v15.active {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1100px) {
    .avion-grid-v15 {
      grid-template-columns: 1fr;
      padding: 40px 20px;
    }
    .jerry-col-v15 {
      order: 2; 
    }
    .text-col-v15 {
      padding-top: 20px;
      padding-bottom: 40px;
      text-align: center;
    }
  }
{% endstyle %}

<section class="avion-story-final-v15">
  <div class="avion-grid-v15">
    
    <div class="text-col-v15 reveal-v15">
      <h2>{{ section.settings.title }}</h2>
      <div class="rte">
        {{ section.settings.text_left }}
      </div>
    </div>

    <div class="jerry-col-v15">
      {% if section.settings.image_jerry != blank %}
        <img src="{{ section.settings.image_jerry | image_url: width: 1400 }}" alt="Jerry Wilson">
      {% endif %}
    </div>

    <div class="text-col-v15 reveal-v15" style="transition-delay: 0.3s;">
      <div class="rte">
        {{ section.settings.text_right }}
      </div>
    </div>

  </div>
</section>

<script>
  const observerV15 = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal-v15').forEach(el => observerV15.observe(el));
</script>

{% schema %}
{
  "name": "Avión Story Jerry Abajo",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "THE STORY" },
    { "type": "image_picker", "id": "image_jerry", "label": "Imagen Jerry" },
    { "type": "richtext", "id": "text_left", "label": "Texto Izquierda" },
    { "type": "richtext", "id": "text_right", "label": "Texto Derecha" }
  ],
  "presets": [{ "name": "Avión Story Jerry Abajo" }]
}
{% endschema %}