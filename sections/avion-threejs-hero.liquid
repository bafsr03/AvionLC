{% comment %}
  Avion 3D Hero
  ─────────────
  Embeds the Three.js scroll-animation engine as the homepage hero.

  Required setup (one-time):
    1. Go to Shopify Admin → Content → Files
    2. Upload your airplane model  → paste its URL into "Airplane model URL"
    3. Upload your sky environment → paste its URL into "Sky environment URL"
    4. Pick your logo image using the image picker below

  The canvas is position:fixed and fullscreen.  All subsequent page
  sections need a stacking context above it — the CSS block below handles
  this automatically for the active page.
{% endcomment %}

{%- comment %} Resolve backdrop URLs — fall back to bundled asset if settings are blank ── {%- endcomment %}
{%- if section.settings.backdrop_desktop_url != blank -%}
  {%- assign ldr_bg_desktop = section.settings.backdrop_desktop_url -%}
{%- else -%}
  {%- assign ldr_bg_desktop = 'backdrop.png' | asset_url -%}
{%- endif -%}
{%- if section.settings.backdrop_mobile_url != blank -%}
  {%- assign ldr_bg_mobile = section.settings.backdrop_mobile_url -%}
{%- else -%}
  {%- assign ldr_bg_mobile = ldr_bg_desktop -%}
{%- endif -%}

{% style %}

  /* ── Stacking fix ────────────────────────────────────────────────────────
     The canvas is position:fixed; z-index:0.  Every .shopify-section that
     follows must sit above it so its solid background covers the canvas
     as the user scrolls past the hero.  We scope this to pages that
     actually carry this section so it never leaks to other templates.   */
  .avion-hero-page .shopify-section {
    position: relative;
    z-index: 1;
  }
  /* The hero's own shopify-section wrapper must NOT participate in stacking
     so its fixed children (canvas, overlays) stack against the viewport. */
  .avion-hero-page #shopify-section-{{ section.id }} {
    position: static;
    z-index: auto;
    background: transparent;
  }

  /* ── Loading screen ──────────────────────────────────────────────────── */
  #avion-loading {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }
  #avion-loading.avion-loading--hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Backdrop photo — pixel-perfect cover, no overflow */
  .avion-loading-bg {
    position: absolute;
    inset: 0;
    background-image: url("{{ ldr_bg_desktop }}");
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    filter: saturate(0.82) brightness(0.7);
    z-index: 0;
  }
  @media (max-width: 640px) {
    .avion-loading-bg {
      background-image: url("{{ ldr_bg_mobile }}");
      /* Portrait crop: keep subject centred vertically */
      background-position: center center;
    }
  }

  /* Vignette — darker at edges, lighter through centre so backdrop logo shows */
  .avion-loading-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 80% 65% at 50% 42%, transparent 25%, rgba(2,7,3,0.68) 100%),
      linear-gradient(180deg, rgba(2,7,3,0.15) 0%, rgba(2,7,3,0.55) 100%);
  }

  /* Film grain */
  .avion-loading-grain {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    pointer-events: none;
  }

  /* Push controls to bottom — lets the backdrop (with its logo) breathe above */
  #avion-loading {
    align-items: flex-end;
    padding-bottom: clamp(6vh, 9vh, 11vh);
  }

  /* Content strip */
  .avion-loading-inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: min(480px, 88vw);
    gap: 0;
  }

  /* Divider */
  .avion-loading-divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(190,206,128,0.45) 50%,
      transparent 100%);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: avionLdrIn 0.7s ease 0.35s forwards;
  }

  /* Progress track */
  .avion-loading-bar {
    position: relative;
    width: 100%;
    height: 1px;
    background: rgba(190,206,128,0.14);
    margin-bottom: 1.1rem;
    opacity: 0;
    animation: avionLdrIn 0.7s ease 0.45s forwards;
  }

  #avion-loading-fill {
    position: absolute;
    left: 0; top: 0;
    height: 100%;
    width: 0%;
    max-width: 100%;
    background: linear-gradient(90deg, #7a5c14 0%, #bece80 100%);
    box-shadow: 0 0 10px rgba(190,206,128,0.65), 0 0 24px rgba(190,206,128,0.25);
    transition: width 0.28s ease;
  }

  /* Plane glyph rides the leading edge */
  #avion-loading-fill::after {
    content: '✈';
    position: absolute;
    right: -0.6em;
    top: 50%;
    transform: translateY(-62%);
    font-size: 0.78rem;
    color: rgba(252,220,80,0.92);
    filter: drop-shadow(0 0 6px rgba(252,220,80,0.7));
    line-height: 1;
  }

  /* Percentage */
  .avion-loading-pct-display {
    opacity: 0;
    animation: avionLdrIn 0.7s ease 0.55s forwards;
    margin-bottom: 0.45rem;
    font-variant-numeric: tabular-nums;
  }
  #avion-loading-pct {
    font-family: 'Young Serif', Georgia, serif;
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-weight: 400;
    color: rgba(238,235,218,0.92);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  /* Label */
  .avion-loading-label {
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(190,206,128,0.48);
    font-family: system-ui, sans-serif;
    margin: 0;
    padding: 0;
    opacity: 0;
    animation: avionLdrIn 0.7s ease 0.65s forwards;
  }

  @keyframes avionLdrIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Mobile overrides ──────────────────────────────────────────────── */
  @media (max-width: 640px) {
    #avion-loading {
      padding-bottom: clamp(5vh, 8vh, 10vh);
    }
    .avion-loading-inner {
      width: 90vw;
    }
    .avion-loading-bg {
      /* On portrait mobile keep subject centred */
      background-position: center center;
    }
    #avion-loading-pct {
      font-size: clamp(2.2rem, 10vw, 2.8rem);
    }
    .avion-loading-label {
      font-size: 0.55rem;
      letter-spacing: 0.22em;
    }
  }

  /* ── Canvas ──────────────────────────────────────────────────────────── */
  #avion-webgl {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    display: block;
  }

  /* ── Hero overlay (logo reveal) ──────────────────────────────────────── */
  #avion-hero-overlay {
    position: absolute;
    width: 100%; height: 100vh;
    top: 0; left: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
    opacity: 0;
  }
  .avion-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
  }
  .avion-hero-logo {
    width: clamp(180px, 35vw, 380px);
    height: auto;
    /* Drop-shadow so the logo reads against any sky tone */
    filter: drop-shadow(0 4px 32px rgba(0,0,0,0.55))
            drop-shadow(0 0  12px rgba(0,0,0,0.35));
    user-select: none;
    -webkit-user-drag: none;
  }
  .avion-scroll-hint {
    font-size: 1.4rem;
    color: rgba(241,245,249,0.55);
    animation: avion-bounce 2.4s ease-in-out infinite;
    font-family: system-ui, sans-serif;
  }
  @keyframes avion-bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(10px); }
  }
  /* ── Spacer to keep hero fullscreen ────────────────────────────────────────── */
  #avion-hero-spacer {
    height: 100vh;
    position: relative;
    z-index: 1;
    pointer-events: none;
  }

  /* ── Section bridge (canvas → page content gradient) ─────────────────── */
  #avion-section-bridge {
    position: relative;
    z-index: 15;
    height: 28vh;
    background: linear-gradient(
      to bottom,
      transparent,
      {{ section.settings.bridge_color }}
    );
    pointer-events: none;
  }

{% endstyle %}

{%- comment %} Mark the page so stacking CSS above only applies here ─────── {%- endcomment %}
<script>document.documentElement.classList.add('avion-hero-page')</script>

{%- comment %} Inject config for the JS bundle ──────────────────────────── {%- endcomment %}
<script>
  window.AvionHero = {
    glbUrl: {{ section.settings.glb_url | default: '' | json }},
    exrUrl: {{ section.settings.exr_url | default: '' | json }},
    theatreState: (function(){
      var raw = {% if section.settings.theatre_state != blank %}{{ section.settings.theatre_state | json }}{% else %}'{}'{% endif %};
      try { return JSON.parse(raw); } catch(e) { return {}; }
    })(),
    sceneConfig: (function(){
      var raw = {% if section.settings.scene_config != blank %}{{ section.settings.scene_config | json }}{% else %}'{}'{% endif %};
      try { return JSON.parse(raw); } catch(e) { return {}; }
    })(),
    animTiming: [
      { start: {{ section.settings.anim0_start | divided_by: 100.0 }}, end: {{ section.settings.anim0_end | divided_by: 100.0 }} },
      { start: {{ section.settings.anim1_start | divided_by: 100.0 }}, end: {{ section.settings.anim1_end | divided_by: 100.0 }} }
    ]
  }
</script>

{%- comment %} Preload backdrop — tells browser to fetch it at top priority before CSS parses {%- endcomment %}
<link rel="preload" as="image" href="{{ ldr_bg_desktop }}" media="(min-width: 641px)" fetchpriority="high">
<link rel="preload" as="image" href="{{ ldr_bg_mobile }}" media="(max-width: 640px)" fetchpriority="high">

{%- comment %} Loading screen ─────────────────────────────────────────────── {%- endcomment %}
<div id="avion-loading">
  <div class="avion-loading-bg"></div>
  <div class="avion-loading-vignette"></div>
  <div class="avion-loading-grain"></div>
  <div class="avion-loading-inner">
    <div class="avion-loading-divider"></div>
    <div class="avion-loading-bar">
      <div id="avion-loading-fill"></div>
    </div>
    <div class="avion-loading-pct-display">
      <span id="avion-loading-pct">0%</span>
    </div>
    <p class="avion-loading-label">Loading experience</p>
  </div>
</div>

{%- comment %} Cap loading progress at 100 — GLTFLoader onProgress can report loaded > total {%- endcomment %}
<script>
(function () {
  var fill = document.getElementById('avion-loading-fill');
  var pct  = document.getElementById('avion-loading-pct');

  /* Watch fill's style attribute and clamp width to 100% */
  if (fill) {
    new MutationObserver(function () {
      var w = parseFloat(fill.style.width);
      if (!isNaN(w) && w > 100) fill.style.width = '100%';
    }).observe(fill, { attributes: true, attributeFilter: ['style'] });
  }

  /* Intercept textContent setter on the percentage span */
  if (pct) {
    Object.defineProperty(pct, 'textContent', {
      configurable: true,
      get: function () {
        return pct.firstChild ? pct.firstChild.nodeValue : '';
      },
      set: function (v) {
        var n = parseInt(v, 10);
        var capped = (isNaN(n) ? v : Math.min(100, n) + '%');
        if (pct.firstChild) { pct.firstChild.nodeValue = capped; }
        else { pct.appendChild(document.createTextNode(capped)); }
      }
    });
  }
})();
</script>

{%- comment %} WebGL canvas ───────────────────────────────────────────────── {%- endcomment %}
<canvas id="avion-webgl"></canvas>

{%- comment %} Hero overlay — logo fades in at end of animation ─────────── {%- endcomment %}
<div id="avion-hero-overlay">
  <div class="avion-hero-content">
    {%- if section.settings.logo_image != blank -%}
      {{
        section.settings.logo_image
          | image_url: width: 760
          | image_tag:
            class: 'avion-hero-logo',
            alt: shop.name,
            loading: 'eager',
            widths: '280, 380, 560, 760',
            sizes: 'clamp(180px, 35vw, 380px)'
      }}
    {%- endif -%}
  </div>
</div>

<div id="avion-hero-spacer"></div>
<div id="avion-section-bridge"></div>

{%- comment %} Three.js bundle ─────────────────────────────────────────────── {%- endcomment %}
<script type="module" src="{{ 'avion-hero.js' | asset_url }}"></script>

{%- comment %} Theatre.js camera controller (loads Studio only when ?theatre is in URL) {%- endcomment %}
<script type="module" src="{{ 'avion-theatre.js' | asset_url }}"></script>

{%- comment %} Scene editor — only loaded when ?edit is in the URL ─────────── {%- endcomment %}
<script>
  if (new URLSearchParams(location.search).has('edit')) {
    var s = document.createElement('script');
    s.type = 'module';
    s.src = {{ 'avion-edit.js' | asset_url | json }};
    document.head.appendChild(s);
  }
</script>

{% schema %}
{
  "name": "Avion 3D Hero",
  "tag": "div",
  "class": "avion-threejs-hero",
  "settings": [
    {
      "type": "header",
      "content": "Loading Screen Backdrop"
    },
    {
      "type": "paragraph",
      "content": "Upload images via Admin → Content → Files. Copy the CDN URL and paste below. Desktop: 1920×1080 WebP (~200 KB). Mobile: 750×1334 WebP (~120 KB)."
    },
    {
      "type": "text",
      "id": "backdrop_desktop_url",
      "label": "Desktop backdrop URL",
      "info": "Shown on screens wider than 640 px. Leave blank to use the bundled backdrop.png."
    },
    {
      "type": "text",
      "id": "backdrop_mobile_url",
      "label": "Mobile backdrop URL",
      "info": "Shown on screens 640 px and narrower. Falls back to the desktop image if blank."
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Displayed at the end of the scroll animation. Transparent PNG recommended."
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Show scroll arrow",
      "default": true
    },
    {
      "type": "header",
      "content": "3D Assets"
    },
    {
      "type": "text",
      "id": "glb_url",
      "label": "Airplane model URL (.glb)",
      "info": "Upload your .glb file via Admin → Content → Files and paste the CDN URL here."
    },
    {
      "type": "text",
      "id": "exr_url",
      "label": "Sky environment URL (.exr)",
      "info": "Upload your .exr file via Admin → Content → Files and paste the CDN URL here. Leave blank for a procedural sky."
    },
    {
      "type": "header",
      "content": "Scroll Timing"
    },
    {
      "type": "range",
      "id": "animation_zone_vh",
      "label": "Animation scroll height (vh)",
      "min": 200,
      "max": 700,
      "step": 50,
      "default": 400,
      "info": "How many viewport-heights of scrolling cover the full animation. Higher = slower playback."
    },
    {
      "type": "range",
      "id": "pause_zone_vh",
      "label": "Logo dwell height (vh)",
      "min": 40,
      "max": 250,
      "step": 10,
      "default": 120,
      "info": "How long the logo lingers before the page content slides in."
    },
    {
      "type": "header",
      "content": "Transition"
    },
    {
      "type": "color",
      "id": "bridge_color",
      "label": "Fade-out colour",
      "default": "#1a1a1a",
      "info": "The canvas fades into this colour before the next section begins. Match your first section's background."
    },
    {
      "type": "header",
      "content": "Animation Timing"
    },
    {
      "type": "paragraph",
      "content": "Set the scroll window (0–100%) when each GLB animation plays. Animation 1 = airplane. Animation 2 = drop object."
    },
    {
      "type": "range",
      "id": "anim0_start",
      "label": "Anim 1 (airplane) — start %",
      "min": 0, "max": 100, "step": 1, "default": 0
    },
    {
      "type": "range",
      "id": "anim0_end",
      "label": "Anim 1 (airplane) — end %",
      "min": 0, "max": 100, "step": 1, "default": 100
    },
    {
      "type": "range",
      "id": "anim1_start",
      "label": "Anim 2 (drop) — start %",
      "min": 0, "max": 100, "step": 1, "default": 90
    },
    {
      "type": "range",
      "id": "anim1_end",
      "label": "Anim 2 (drop) — end %",
      "min": 0, "max": 100, "step": 1, "default": 100
    },
    {
      "type": "header",
      "content": "Camera (Theatre.js)"
    },
    {
      "type": "textarea",
      "id": "theatre_state",
      "label": "Theatre state JSON",
      "default": "{}",
      "info": "Paste the JSON exported from __exportAvionState() here after editing camera keyframes in Studio (?theatre mode)."
    },
    {
      "type": "header",
      "content": "Scene Config (lights, fog, effects)"
    },
    {
      "type": "textarea",
      "id": "scene_config",
      "label": "Scene Config JSON",
      "default": "{}",
      "info": "Paste the JSON exported from the live editor (?edit mode). Controls all lights, atmosphere, bloom, stars, clouds, and particles."
    }
  ],
  "presets": [
    {
      "name": "Avion 3D Hero",
      "settings": {
        "animation_zone_vh": 400,
        "pause_zone_vh": 120,
        "bridge_color": "#1a1a1a",
        "show_scroll_hint": true
      }
    }
  ]
}
{% endschema %}
